FROM golang:1.25.3-alpine

# Install build dependencies and delve
RUN apk add --no-cache git gcc musl-dev
RUN go install github.com/go-delve/delve/cmd/dlv@latest

# Create non-root user
RUN adduser -D -u 1000 webhook

# Set up workspace
WORKDIR /workspace

# Copy go.mod and go.sum first for better caching
COPY --chown=webhook:webhook go.mod go.sum ./
RUN go mod download

# Copy the source code
COPY --chown=webhook:webhook . .

# Build with debug information
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -buildvcs=false -gcflags="all=-N -l" -o webhook ./cmd/webhook

# Switch to non-root user
USER webhook

# Expose webhook and debug ports
EXPOSE 8443 40000

# Run delve
ENTRYPOINT ["dlv", "--listen=:40000", "--headless=true", "--api-version=2", "--accept-multiclient", "exec", "./webhook", "--"]
